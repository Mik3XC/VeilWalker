<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Near-black launch screen, so the app doesn't flash white before the terminal UI. Other keys are generated
	     from INFOPLIST_KEY_* build settings. -->
	<!-- Live walks keep GPS (and so the app, CMPedometer and Tor) running with the screen off. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<!-- BGAppRefreshTask: sync unsent days over Tor while the app is closed, then stop Tor. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.premisei3.veilwalker.sync</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
