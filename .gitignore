# VeilWalker monorepo: android/ (app, core, backend, rust) and ios/ (iPhone app).
# Each side keeps its own .gitignore too (android/.gitignore, ios/.gitignore).

.DS_Store

# Original hand-over archives and the loose copy of android/docs
*.zip
/docs/

# Never commit signing material or secrets, anywhere
*.keystore
*.jks
*.p12
*.cer
*.mobileprovision
*.certSigningRequest
.env
.env.*
local.properties

# Release builds and demo videos (AABs, mp4): kept locally in android/dist/
android/dist/
